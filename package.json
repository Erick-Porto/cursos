{
  "name": "cursos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "content:check": "node scripts/content.mjs check",
    "content:sync": "node --env-file=.env scripts/content.mjs sync",
    "content:sync:prune": "node --env-file=.env scripts/content.mjs sync --prune",
    "db:check": "node scripts/check-migrations.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "highlight.js": "^11.11.1",
    "jspdf": "^3.0.1",
    "lucide-vue-next": "^0.487.0",
    "markdown-it": "^14.1.0",
    "markdown-it-container": "^4.0.0",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-container": "^2.0.10",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "gray-matter": "^4.0.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
