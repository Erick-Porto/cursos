# ---------------------------------------------------------------
# Front-end (prefixo VITE_ = vai para o bundle público, sem segredo)
# ---------------------------------------------------------------
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...chave-anon-publica...

# Caminho base do site. Local: "/". No GitHub Pages o Actions define
# automaticamente como "/<nome-do-repositorio>/".
VITE_BASE=/

# Mostra o botão "Entrar com Google" (exige provider configurado no Supabase)
VITE_ENABLE_GOOGLE_LOGIN=false

# ---------------------------------------------------------------
# Apenas scripts locais (npm run content:sync). NUNCA vai para o
# bundle nem para o git. Pegue em Supabase > Settings > API.
# ---------------------------------------------------------------
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...chave-service-role-secreta...
